#!/bin/bash
# __NAME__ installer: copies the plugins into your user plug-in folders,
# removes the macOS download quarantine flag and, if you agree, checks the Audio Unit with Apple's auval.
# The check is optional: whatever it says (or if it cannot run), the installation itself is already complete.
cd "$(dirname "$0")" || exit 1
set -e

AU_DIR="$HOME/Library/Audio/Plug-Ins/Components"
VST3_DIR="$HOME/Library/Audio/Plug-Ins/VST3"
mkdir -p "$AU_DIR" "$VST3_DIR"

rm -rf "$AU_DIR/__NAME__.component" "$VST3_DIR/__NAME__.vst3"
cp -R "__NAME__.component" "$AU_DIR/"
cp -R "__NAME__.vst3" "$VST3_DIR/"
xattr -dr com.apple.quarantine "$AU_DIR/__NAME__.component" "$VST3_DIR/__NAME__.vst3" 2>/dev/null || true

# make the system rescan Audio Units
killall -9 AudioComponentRegistrar 2>/dev/null || true

echo ""
echo "__NAME__ installed / установлен:"
echo "  AU   -> $AU_DIR/__NAME__.component"
echo "  VST3 -> $VST3_DIR/__NAME__.vst3"
echo ""

# ---------------------------------------------------------------------------------------------------------------
# Optional Audio Unit check (auval). From here on nothing can make the installer fail.
set +e
ANSWER="y"
if [ -t 0 ]; then
    printf "Проверить AU через auval сейчас? / Check the AU with auval now? [Y/n] (15 s): "
    read -r -t 15 ANSWER || ANSWER="y"
    echo ""
fi
case "$ANSWER" in
    [nNнН]*)
        echo "Проверка AU пропущена. / AU check skipped."
        ;;
    *)
        if ! command -v auval >/dev/null 2>&1; then
            echo "auval недоступен на этом Mac — проверка пропущена, установка выполнена."
            echo "auval is not available on this Mac - check skipped, the installation is complete."
        else
            LOG="$(mktemp -t mas18-auval 2>/dev/null || echo "/tmp/mas18-auval.$$")"
            echo "Проверяю AU (обычно 5-30 секунд)... / Checking the AU (usually 5-30 seconds)..."
            sleep 2                                    # give the registrar a moment after the restart
            auval -v aufx __CODE__ Mast > "$LOG" 2>&1 &
            PID=$!
            WAITED=0
            while kill -0 "$PID" 2>/dev/null && [ "$WAITED" -lt 120 ]; do sleep 1; WAITED=$((WAITED + 1)); done
            if kill -0 "$PID" 2>/dev/null; then
                kill "$PID" 2>/dev/null
                RESULT="timeout"
            elif grep -q "AU VALIDATION SUCCEEDED" "$LOG"; then
                RESULT="ok"
            elif grep -qi "Cannot get Component\|didn't find the component" "$LOG"; then
                RESULT="notfound"
            else
                RESULT="failed"
            fi
            REPORT="$LOG"
            if [ "$RESULT" != "ok" ]; then             # keep the report where it is easy to find (Desktop)
                cp "$LOG" "$HOME/Desktop/__NAME__ - AU check.txt" 2>/dev/null && REPORT="$HOME/Desktop/__NAME__ - AU check.txt"
            fi
            echo ""
            case "$RESULT" in
                ok)
                    echo "AU ПРОВЕРЕН: OK (AU VALIDATION SUCCEEDED)."
                    echo "AU CHECK: OK."
                    ;;
                notfound)
                    echo "macOS пока не видит этот AU. Обычно помогает перезагрузка Mac или повторный запуск установщика."
                    echo "macOS does not see this AU yet. A restart of the Mac or running the installer again usually helps."
                    ;;
                timeout)
                    echo "Проверка AU не уложилась в 2 минуты и остановлена. Установка выполнена; VST3 работает в любом случае."
                    echo "The AU check took longer than 2 minutes and was stopped. The installation is complete."
                    ;;
                *)
                    echo "AU НЕ прошёл проверку. VST3 установлен и работает. Отчёт: $REPORT"
                    echo "The AU did NOT pass the check. VST3 is installed. Report: $REPORT"
                    ;;
            esac
            if [ "$RESULT" = "notfound" ] || [ "$RESULT" = "timeout" ]; then echo "Отчёт / report: $REPORT"; fi
        fi
        ;;
esac

echo ""
echo "Перезапустите DAW. / Restart your DAW."
echo "  Logic: Audio FX > Audio Units > masterastakhovsound > __NAME__"
echo "  REAPER: Preferences > Plug-ins > AU: включите «Enable inserting AU plug-ins», затем «Re-scan» (или «Clear cache / re-scan»)."
exit 0
